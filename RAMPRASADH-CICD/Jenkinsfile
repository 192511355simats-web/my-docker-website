
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'ramprasadh-portfolio'
        CONTAINER_NAME = 'ramprasadh-site'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image'
                sh 'docker build -t ramprasadh-portfolio .'
            }
        }

        stage('Test Website') {
            steps {
                echo 'Testing website'
                sh '''
                    docker run -d --name portfolio-test -p 8082:80 ramprasadh-portfolio
                    sleep 5
                    docker exec portfolio-test wget -qO- http://localhost/
                    docker rm -f portfolio-test
                '''
            }
        }

        stage('Deploy Website') {
            steps {
                echo 'Deploying portfolio website'
                sh '''
                    docker rm -f ramprasadh-site || true
                    docker run -d --name ramprasadh-site -p 8081:80 ramprasadh-portfolio
                '''
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
